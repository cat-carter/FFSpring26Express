<main>

<div class="card confirm-header">
  <div class="confirm-check">
    <i data-lucide="circle-check"></i>
  </div>
  <div>
    <h1>Submission Confirmed</h1>
    <p class="card-subtitle">Your course information has been successfully submitted.</p>
  </div>
</div>


<div class="card">
  <div class="confirm-details-grid">
    <div>
      <div class="section-header">
        <i data-lucide="book-open"></i>
        <h2>Course Details</h2>
      </div>
      <p><strong>Course:</strong> {{course.code}}</p>
      <p><strong>Faculty:</strong> {{submission.facultyName}}</p>
      <p><strong>Semester:</strong> {{submission.semester}}</p>
    </div>
    <div>
      <div class="section-header">
        <i data-lucide="calendar"></i>
        <h2>Submitted On</h2>
      </div>  
      <p>{{submission.createdAt}}</p>
    </div>
  </div>
  </div>
    

<div class="card">
  <div class="section-header">
    <i data-lucide="file-text"></i>
    <h2>Uploaded Files</h2>
  </div>
  <p class="card-subtitle">You have successfully uploaded the following files:</p>

  <div class="doc-list">
    {{#if submission.syllabusFileName}}
    <div class="doc-item">
      <i data-lucide="file"></i>
        <a href="/faculty/{{submission.id}}/syllabus">{{submission.syllabusFileName}}</a>
         </div>
    {{else}}
    <div class="doc-item">
      <i data-lucide="file"></i>
      <span class="text-muted">Syllabus not uploaded</span>
    </div>
    {{/if}}

    {{#if submission.rubricFileName}}
    <div class="doc-item">
      <i data-lucide="file"></i>
      <a href="/faculty/{{submission.id}}/rubric">{{submission.rubricFileName}}</a>
      </div>  
    {{else}}
    <div class="doc-item">
      <i data-lucide="file"></i>
      <span class="text-muted">Rubric not uploaded</span>
    </div>
    {{/if}} 
  </div>
</div>

<div class="card">
  <div class="section-header">
    <i data-lucide="list-checks"></i>
    <h2>Primary Competencies for This Course</h2> 
  </div>
  <p class="card-subtitle">The following competencies will be assessed through student score submissions:</p>
  <ul class="competency-list">
    {{#each competencies}}
      <li>{{this.name}}</li>
    {{/each}}
  </ul>
</div>  

<div class="card">
  <div class="section-header">
    <i data-lucide="users"></i>
    <h2>Next Steps: Submit Student Scores</h2>    
  </div>
  <p class="card-subtitle">Download the template below, fill in student IDs and scores (1, 2, or 3) for each competency, then upload the completed file at the end of the course.</p>
  <br>
  <a href="/faculty/{{submission.id}}/template" class="btn btn-secondary">Download CSV Template</a>
  <br><br>
  <div class="confirm-note">
    <i data-lucide="info"></i>
  <p>At the end of the semester, you can upload the completed CSV file through your faculty dashboard.</p>
    </div>
  
<br>

 <hr class="section-divider">
 <br>
  <h3 class="upload-heading">Upload Completed Scores</h3>
  <p class="card-subtitle">Once you have filled in the CSV template, upload it here.</p>
  <form action="/faculty/{{submission.id}}/scores" method="POST" enctype="multipart/form-data">
    <div class="form-group">
      <input type="file" name="csvFile" accept=".csv" required>
    </div>
    <button type="submit" class="btn btn-primary">Upload Scores</button>
  </form>
  </div>  

</div>  
</main> 
