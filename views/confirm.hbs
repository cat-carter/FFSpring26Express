fieldset {
  border: 1px solid #ddd;
  border-radius: 5px;
  padding: 1rem 1.5rem;
  margin-bottom: 1.2rem;
}

legend {
  font-weight: 600;
  color: #005030;
  padding: 0 0.5rem;
}

<div class="card">
  <h1>Submission Confirmed</h1>
  <p><strong>Course:</strong> {{course.code}}</p>
  <p><strong>Faculty:</strong> {{submission.facultyName}}</p>
  <p><strong>Semester:</strong> {{submission.semester}}</p>
  <p><strong>Status:</strong> {{submission.status}}</p>
  <p><strong>Syllabus:</strong> 
  <p><strong>Higher-Level Teaching:</strong> {{submission.higherTeachingPct}}%</p>
  <p><strong>Lower-Level Teaching:</strong> {{submission.lowerTeachingPct}}%</p>  
  <p><strong>Higher-Level Assessment:</strong> {{submission.higherAssessmentPct}}%</p>
  <p><strong>Lower-Level Assessment:</strong> {{submission.lowerAssessmentPct}}%</p>

  {{#if submission.syllabusFileName}}
    <a href="/faculty/{{submission.id}}/syllabus">{{submission.syllabusFileName}}</a>
  {{else}}
    Not uploaded
  {{/if}}
</p>
<p><strong>Rubric:</strong>
  {{#if submission.rubricFileName}}
    <a href="/faculty/{{submission.id}}/rubric">{{submission.rubricFileName}}</a>
  {{else}}
    Not uploaded
  {{/if}}
</p>
</div>

<div class="card">
  <h2>Primary Competencies for This Course</h2>
  <ul>
    {{#each competencies}}
      <li>{{this.name}}</li>
    {{/each}}
  </ul>
</div>

<div class="card">
  <h2>Submit Student Scores</h2>
  <p>Download the template below, fill in student IDs and scores (1, 2, or 3) for each competency, then upload the completed file.</p>
  <br>
  <a href="/faculty/{{submission.id}}/template" class="btn btn-secondary">Download CSV Template</a>
  <br><br>
  <form method="POST" action="/faculty/{{submission.id}}/scores" enctype="multipart/form-data">
    <div class="form-group">
      <label>Upload Completed CSV</label>
      <input type="file" name="csvFile" accept=".csv" required />
    </div>
    <button type="submit" class="btn btn-primary">Upload Scores</button>
  </form>
</div>




