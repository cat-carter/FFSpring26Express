<main>
  <div class="card">
    <h1>Submission Tracker</h1>
  </div>

  {{#each semesters}}
  <div class="card">
    <h2>{{semester}}</h2>
    <table class="tracker-table">
      <thead>
        <tr>
          <th>Course</th>
          <th>Program</th>
          <th>Faculty</th>
          <th>Course Documents</th>
          <th>Student Scores</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {{#each submissions}}
        <tr>
          <td>{{Course.code}}</td>
          <td>{{Course.program}}</td>
          <td>{{facultyName}}</td>
          <td>
            {{#if hasDocuments}}
              <a href="/faculty/{{id}}/confirm" class="tracker-badge badge-submitted">&#x1F7E2; Submitted</a>
            {{else}}
              <span class="tracker-badge badge-missing">&#x1F534; Missing</span>
            {{/if}}
          </td>
          <td>
            {{#if hasScores}}
              <span class="tracker-badge badge-submitted">&#x1F7E2; Submitted</span>
            {{else}}
              <span class="tracker-badge badge-missing">&#x1F534; Missing</span>
            {{/if}}
          </td>
          <td>
            {{#if (eq overallStatus 'Completed')}}
              <span class="tracker-badge badge-complete">&#x2705; Completed</span>
            {{else if (eq overallStatus 'Needs Attention')}}
              <span class="tracker-badge badge-attention">&#x26A0;&#xFE0F; Needs Attention</span>
            {{else}}
              <span class="tracker-badge badge-pending">&#x23F3; Pending</span>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/each}}
</main>