<div class="card">
  <h1>Faculty Course Submission</h1>

  <form method="POST" action="/faculty" enctype="multipart/form-data">
    <div class="form-group">
      <label>Program</label>
      <select id="programSelect" name="program" required onchange="filterCourses()">
        <option value="">-- Select program --</option>
        <option value="MHA">MHA</option>
        <option value="HEMBA">HEMBA</option>
  </select>
</div>

<div class="form-group">
  <label>Course</label>
  <select id="courseSelect" name="courseId" required disabled>
    <option value="">-- Select program first --</option>
  </select>
</div>

    <div class="form-group">
      <label>Faculty Name</label>
      <input type="text" name="facultyName" required />
    </div>

    <div class="form-group">
      <label>Faculty Email</label>
      <input type="email" name="facultyEmail" required />
    </div>

    <div class="form-group">
      <label>Semester</label>
      <select name="semester" required>
        <option value="">-- Select semester --</option>
        <option value="Spring 2026">Spring 2026</option>
        <option value="Summer 2026">Summer 2026</option>
        <option value="Fall 2026">Fall 2026</option>
        <option value="Spring 2027">Spring 2027</option>
        <option value="Fall 2027">Fall 2027</option>
      </select>
    </div>

<div class="form-group">
  <label>Syllabus</label>
  <input type="file" name="syllabusFile" accept=".pdf,.doc,.docx" />
</div>

<div class="form-group">
  <label>Rubric</label>
  <input type="file" name="rubricFile" accept=".pdf,.doc,.docx" />
</div>

    <button type="submit" class="btn btn-primary">Submit</button>
  </form>
</div>

<script>const allCourses = {{{coursesJSON}}};</script>
<script src="/javascripts/faculty.js"></script>